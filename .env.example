# Data source: mock | shadow | live
# mock   = static demo data (default, no API calls)
# shadow = show mock, fetch joule-core in background to validate wiring
# live   = joule-core is source of truth, fall back to mock on error
VITE_JOULE_DATA_MODE=mock

# joule-core API (required for shadow/live)
VITE_JOULE_API_URL=http://127.0.0.1:8000
VITE_JOULE_API_KEY=dev-key
VITE_JOULE_CLUSTER_ID=
